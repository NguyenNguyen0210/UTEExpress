# ================================
# Application
# ================================
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ================================
# PostgreSQL (Docker Compose)
# ================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uteexpress
POSTGRES_USER=uteexpress
POSTGRES_PASSWORD=changeme_local_password

# ================================
# JWT Security (HS256 - tối thiểu 32 ký tự)
# ================================
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars-long
JWT_EXPIRATION_MS=86400000

# ================================
# VNPay Sandbox (API v2.1.0)
# ================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay-return

# ================================
# Cloudflare R2 (S3-Compatible Object Storage - POD Images)
# ================================
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=uteexpress-pod
